# Dans tous les environnements, les fichiers suivants sont chargés si ils existent,
# ils prennent la priorité sur ce fichier :
#
#  * .env.local contient les variables d'environnement spécifiques à la machine
#  * .env.local.php peut être utilisé pour accélérer le chargement des variables
#    d'environnement. Il doit être mis en cache par Symfony.
#  * .env.$APP_ENV.local charge les variables d'environnement spécifiques à l'environnement
#    uniquement pour l'environnement donné (ex: .env.dev.local, .env.prod.local)
#
# Les fichiers .env sont chargés dans l'ordre suivant :
# 1. .env
# 2. .env.local (ignoré si NODE_ENV=production)
# 3. .env.$APP_ENV
# 4. .env.$APP_ENV.local (ignoré si NODE_ENV=production)

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=${APP_SECRET}
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format décrit dans https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: Vous DEVEZ modifier vos paramètres de base de données dans le fichier .env.local
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

